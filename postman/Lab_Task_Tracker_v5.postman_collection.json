                "check"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-12-25"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Christmas is a holiday\", () => pm.expect(pm.response.json().is_holiday).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Calendar feed (.ics, key in URL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/calendar.ics?key={{apiKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "calendar.ics"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is iCalendar\", () => pm.expect(pm.response.text()).to.include(\"BEGIN:VCALENDAR\"));"
                ]
              }
            }
          ]
        }
      ]
    },
