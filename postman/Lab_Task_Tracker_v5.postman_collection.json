                },
                {
                  "key": "country",
                  "value": "US"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has holidays\", () => pm.expect(pm.response.json().count).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Is this date a holiday?",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/holidays/check?date=2026-12-25",
              "host": [
