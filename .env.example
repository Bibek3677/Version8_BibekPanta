# Copy this file to .env and fill in your own values.
# NEVER commit or submit the real .env: these keys give full access.

# Supabase: Project Settings > Data API (URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Key that clients (the web page, Postman) must send to use this app's API.
# Make up a long random string.
API_KEY="apple"

# Country for public holiday checks (two-letter code)
HOLIDAY_COUNTRY=US

# Optional: Make.com (or any) webhook that receives task events
# (task.created, task.updated, task.completed, task.reopened, task.deleted,
# tasks.cleared). Leave empty to turn it off.
WEBHOOK_URL=
